# Copy to server/.env and fill in. Never commit .env.
PORT=5000

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# --- Email delivery (all of SMTP_HOST, SMTP_USER, SMTP_PASS required) ---
# Gmail example: enable 2-Step Verification, then create an "App password"
# at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Where messages are delivered (defaults to SMTP_USER) and the "from" address
CONTACT_TO=your-email@gmail.com
MAIL_FROM=your-email@gmail.com
